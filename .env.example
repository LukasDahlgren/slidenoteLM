# Copy this file to .env and fill in your credentials.

# --- Fixed Providers ---
# Groq Whisper transcription (required for live transcription)
GROQ_API_KEY=
TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# Google Gemini (Slide OCR + Alignment + Section Notes + Coverage Audit)
# Gemini 4 models may require a paid Gemini API billing tier depending on your Google AI Studio plan.
# Override models via OCR_MODEL_GOOGLE, LLM_ALIGN_MODEL, LLM_NOTES_MODEL, and LLM_COVERAGE_MODEL.
GEMINI_API_KEY=
OCR_MODEL_GOOGLE=gemini-4-neon
# Valid thinking levels: MINIMAL, LOW, MEDIUM, HIGH, XHIGH (OFF/NONE maps to MINIMAL on Gemini 4; DEFAULT uses model default)
OCR_THINKING_LEVEL=LOW

# Optional: Vertex AI mode instead of GEMINI_API_KEY
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1

# --- Pipeline LLM Mode & Per-Stage Tuning (Gemini 4 Neon, varied thinking levels) ---
# "gemini" (or "live") runs live Google Gemini calls for Alignment, Notes, and Coverage Audit.
# "stub" runs deterministic local scaffolding without LLM calls (useful for offline tests).
# Valid thinking levels for LLM_*_THINKING_LEVEL: MINIMAL, LOW, MEDIUM, HIGH, XHIGH (OFF/NONE maps to MINIMAL on Gemini 4; DEFAULT uses model default).
PIPELINE_LLM_MODE=gemini
LLM_ALIGN_MODEL=gemini-4-neon
LLM_ALIGN_THINKING_LEVEL=HIGH
LLM_NOTES_MODEL=gemini-4-neon
LLM_NOTES_THINKING_LEVEL=HIGH
LLM_COVERAGE_MODEL=gemini-4-neon
LLM_COVERAGE_THINKING_LEVEL=MEDIUM

# Optional LLM runtime tuning (LLM_RATE_LIMIT_RPM is tracked separately from OCR_RATE_LIMIT_RPM; each defaults to 20 RPM):
# LLM_ALIGN_MAX_OUTPUT_TOKENS=32768
# LLM_NOTES_MAX_OUTPUT_TOKENS=32768
# LLM_COVERAGE_MAX_OUTPUT_TOKENS=16384
# LLM_GLOBAL_MAX_CONCURRENT=4
# LLM_RATE_LIMIT_RPM=20
# LLM_RETRY_ATTEMPTS=4
# LLM_RETRY_BASE_DELAY_SECONDS=2
# LLM_TIMEOUT_SECONDS=300

# --- Local Runtime ---
DATA_DIR=./data
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# --- Optional Password Gate (leave empty locally to disable auth) ---
# Set APP_PASSWORD on hosted deployments (e.g. Railway) to require a login gate.
# APP_SESSION_SECRET is optional; when empty, cookie signing derives a stable key from APP_PASSWORD.
APP_PASSWORD=
APP_SESSION_SECRET=

# --- API Rate Limits (optional; sliding window per client IP, set a limit to 0 to disable) ---
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_WINDOW_SECONDS=60
# RATE_LIMIT_TRUST_PROXY_HEADERS=true
# RATE_LIMIT_AUTH_LOGIN_PER_MINUTE=10
# RATE_LIMIT_AUTH_PER_MINUTE=60
# RATE_LIMIT_JOBS_CREATE_PER_MINUTE=10
# RATE_LIMIT_JOBS_READ_PER_MINUTE=120
# RATE_LIMIT_HEALTH_PER_MINUTE=120
# RATE_LIMIT_DEFAULT_PER_MINUTE=120

# --- Audio & Transcription Tuning (optional) ---
# TRANSCRIBE_TARGET_BITRATE=32k
# TRANSCRIBE_MAX_UPLOAD_BYTES=24000000
# TRANSCRIBE_CHUNK_HEADROOM_PCT=90
# TRANSCRIBE_MIN_CHUNK_SECONDS=300
# TRANSCRIBE_PARALLEL_WORKERS=4
# TRANSCRIBE_GLOBAL_MAX_CONCURRENT=6
# TRANSCRIBE_RATE_LIMIT_RPM=20
# TRANSCRIBE_RETRY_ATTEMPTS=3
# TRANSCRIBE_RETRY_BASE_DELAY_SECONDS=3
# TRANSCRIBE_TIMEOUT_SECONDS=180
# FFMPEG_PATH=
# FFPROBE_PATH=

# --- Slide OCR Tuning (optional) ---
# OCR_MAX_PAGES_PER_BATCH=20
# OCR_MAX_BATCH_BYTES=18874368
# OCR_PARALLEL_WORKERS=2
# OCR_PARALLEL_MIN_PAGES=4
# OCR_GLOBAL_MAX_CONCURRENT=4
# OCR_RATE_LIMIT_RPM=20  # tracked separately from LLM_RATE_LIMIT_RPM (each defaults to 20 RPM)
# OCR_RETRY_ATTEMPTS=3
# OCR_RETRY_BASE_DELAY_SECONDS=2
# OCR_TIMEOUT_SECONDS=180
# OCR_MAX_OUTPUT_TOKENS=32768

# --- Optional: Bitwarden Secrets Manager (bws) ---
# Store GROQ_API_KEY and GEMINI_API_KEY in a Bitwarden Secrets Manager project
# instead of putting API keys in .env. Do NOT put BWS_ACCESS_TOKEN in .env or
# persistent OS environment variables — scripts/run-backend.ps1 (Windows) and
# scripts/run-backend.sh (macOS/Linux) prompt for it with hidden input. Only
# the non-secret project UUID goes here:
# BWS_PROJECT_ID=
